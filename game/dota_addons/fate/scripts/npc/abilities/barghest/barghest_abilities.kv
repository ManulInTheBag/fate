"DOTAAbilities"
{

	//=====================================
	// Knight's Cadence
	//=====================================
	"barghest_q"
	{
		"BaseClass"					"ability_lua"
		"ScriptFile"				"abilities/barghest/barghest_q"
		"AbilityTextureName"		"custom/barghest/barghest_q"
		// OVERSHOOT — чтобы клик дальше дальности НЕ гнал героя пешком, а просто
		// задавал направление удара (так же сделан aoko_facebreaker)
		"AbilityBehavior"			"DOTA_ABILITY_BEHAVIOR_POINT | DOTA_ABILITY_BEHAVIOR_OVERSHOOT"
		"AbilityUnitTargetTeam"		"DOTA_UNIT_TARGET_TEAM_ENEMY"
		"AbilityUnitTargetType"		"DOTA_UNIT_TARGET_ALL"
		"AbilityUnitDamageType"		"DAMAGE_TYPE_MAGICAL"
		"LevelsBetweenUpgrades"		"1"
		"MaxLevel"					"5"
		// Кулдаун МЕЖДУ ударами связки. Полный (`full_cooldown`) ставится кодом
		// после третьего удара — иначе связка недостижима.
		"AbilityCooldown"			"0.8"
		"AbilityManaCost"			"40"
		// AbilityCastRange НЕ объявлен намеренно: с OVERSHOOT курсор задаёт
		// только направление и точку приземления, дальность ничего не режет
		// (так же сделан aoko_facebreaker)
		// ⚠️ Справочное значение: каст-пойнт считает GetCastPoint в lua
		// (`cast_point` для стадий 1-2, `spin_cast_point` для вертушки).
		// Держать равным `cast_point`.
		"AbilityCastPoint"			"0.15"
		// перекрывается GetCastAnimation: у каждой стадии своя
		"AbilityCastAnimation"		"ACT_DOTA_CAST_ABILITY_1"
		"precache"
		{
			"particle"			"particles/barghest/barghest_slash_1.vpcf"
			"particle"			"particles/barghest/barghest_slash_2.vpcf"
			"particle"			"particles/barghest/barghest_slash_vertical_up.vpcf"
			"particle"			"particles/barghest/barghest_slam.vpcf"
			"particle"			"particles/barghest/barghest_small_explosion.vpcf"


		}
		"AbilityValues"
		{
			"damage"			"80 105 130 155 180"
			"radius"			"350"
			"arc_angle"			"120"
			"cast_point"			"0.15"		// стадии 1-2; читает GetCastPoint
			"lunge_distance"			"450"		// потолок; фактическая — до курсора
			"lunge_speed"			"1400"
			"lunge_stop_radius"			"200"		// на таком расстоянии выпад тормозит о врага
			"lunge_min_distance"			"80"		// пол дальности: в упор всё равно короткий рывок
			"lunge_no_stop_distance"			"120"		// первые столько единиц о врагов НЕ тормозим
			// Клип удара (ACT_4, vertical_slash2) — 0.54 c при rate 1.0. Столько
			// живут и модификатор выпада, и заморозка анимации: клип отыгрывает
			// целиком, а деш обрывается раньше сам (дошёл / упёрся / встретил врага).
			"lunge_duration"			"0.5"
			"lunge_slam_delay"			"0.1"		// от остановки до удара мечом в землю
			"spin_radius"			"310"
			// Клип вертушки (ACT_3, round_slash1) — 29 кадров на 30 fps ≈ 0.97 c.
			// Каст-пойнт обязан его покрывать, иначе прокрут обрубается движком
			// (IGNORE_BACKSWING) — это и было «слишком быстро».
			"spin_cast_point"			"0.35"		// вертушка длиннее общего каст-пойнта
			"spin_anim_rate"			"1.0"		// замедлять НЕ надо: клип и так ~1 c, иначе лок вырастет вдвое
			"chain_window"			"3.0"
			"full_cooldown"			"7 6.5 6 5.5 5"
		}
	}

	//=====================================
	// Iron Stance
	//=====================================
	"barghest_w"
	{
		"BaseClass"					"ability_lua"
		"ScriptFile"				"abilities/barghest/barghest_w"
		"AbilityTextureName"		"custom/barghest/barghest_w"
		"AbilityBehavior"			"DOTA_ABILITY_BEHAVIOR_NO_TARGET | DOTA_ABILITY_BEHAVIOR_CHANNELLED | DOTA_ABILITY_BEHAVIOR_IGNORE_BACKSWING"
		"AbilityUnitTargetTeam"		"DOTA_UNIT_TARGET_TEAM_ENEMY"
		"AbilityUnitTargetType"		"DOTA_UNIT_TARGET_ALL"
		"AbilityUnitDamageType"		"DAMAGE_TYPE_MAGICAL"
		"LevelsBetweenUpgrades"		"1"
		"MaxLevel"					"5"
		"AbilityCooldown"			"18 17 16 15 14"
		"AbilityManaCost"			"200"
		"AbilityCastRange"			"0"
		"AbilityCastPoint"			"0"
		"AbilityChannelTime"		"2.0"
		"AbilityCastAnimation"		"ACT_DOTA_CHANNEL_ABILITY_1"
         "precache"
		{
			"particle"			"particles/econ/items/lifestealer/lifestealer_immortal_backbone_gold/lifestealer_immortal_backbone_gold_rage_swirl.vpcf"
			"particle"			"particles/barghest/barghest_w_shield.vpcf"
			"particle"			"particles/barghest/barghest_barrier.vpcf"
			"particle"			"particles/barghest/barghest_slash_3.vpcf"

		}
		"AbilityValues"
		{
			"duration"			"2.0"
			"barrier_base"			"150 250 350 450 550"
			"barrier_per_source"			"40 55 70 85 100"
			// Потолок ровно вдвое от базы: подпиткой барьер можно самое большее
			// удвоить. ⚠️ Он и есть главный ограничитель — скорострельные
			// источники (пулемёт Ланселота: 10 попаданий в секунду) упираются в
			// него меньше чем за секунду, и без потолка стойку было бы не пробить.
			"barrier_cap"			"300 500 700 900 1100"
			"barrier_min_damage"			"25"		// удар слабее барьер не кормит
			"barrier_gain_cd"			"0.03"		// общий кулдаун подпитки — один кадр
			"slam_damage"			"100 160 220 280 340"
			"slam_from_absorbed"			"50"		// % поглощённого уходит в удар
			"slam_bonus_cap"			"200 300 400 500 600"
			"slam_radius"			"350"
			"slam_delay"			"0.15"		// замах: урон приходит не мгновенно
			"slam_arc_angle"			"180"		// сектор эффекта удара: полукруг перед собой
			"slam_anim_tail"			"0.5"		// сколько клип удара живёт ПОСЛЕ slam_delay
		}
	}

	//=====================================
	// Chain Hunt
	//=====================================
	"barghest_e"
	{
		"BaseClass"					"ability_lua"
		"ScriptFile"				"abilities/barghest/barghest_e"
		"AbilityTextureName"		"custom/barghest/barghest_e"
		// ⚠️ НЕ канал: канал обрывается любым приказом, а во время зарядки надо
		// доворачиваться приказами движения. Держит на месте рут модификатора
		// зарядки (приём из emiya_caladbolg). NO_TARGET — направление берётся с
		// поворота героя, а не с курсора при касте.
		"AbilityBehavior"			"DOTA_ABILITY_BEHAVIOR_NO_TARGET | DOTA_ABILITY_BEHAVIOR_ROOT_DISABLES | DOTA_ABILITY_BEHAVIOR_IGNORE_BACKSWING"
		"AbilityUnitTargetTeam"		"DOTA_UNIT_TARGET_TEAM_ENEMY"
		"AbilityUnitTargetType"		"DOTA_UNIT_TARGET_ALL"
		"AbilityUnitDamageType"		"DAMAGE_TYPE_MAGICAL"
		"LevelsBetweenUpgrades"		"2"
		"MaxLevel"					"5"
		"AbilityCooldown"			"22 21 20 19 18"
		"AbilityManaCost"			"400"
		"AbilityCastRange"			"1100"
		"AbilityCastPoint"			"0.1"
		"AbilityCastAnimation"		"ACT_DOTA_CHANNEL_ABILITY_2"
		"precache"
		{
			"particle"			"particles/barghest/barghest_rush_e.vpcf"
			"particle"			"particles/barghest/barghest_rush_e_speed.vpcf"
			"particle"			"particles/barghest/barghest_status_fx.vpcf"
			"particle"			"particles/barghest/barghest_e_charge.vpcf"
			"particle"			"particles/barghest/barghest_e_chains.vpcf"
			
		}
		"AbilityValues"
		{
			"charge_time"			"2.0"
			"min_distance"			"350"
			"max_distance"			"1700"
			"speed"			"1700"
			"grab_radius"			"120"		// на таком расстоянии рывок врезается во врага
			"turn_rate"			"260"		// градусов в секунду: доворот ПО ХОДУ рывка
			"chain_duration"			"1.0 1.25 1.5 1.75 2.0"
			"chain_min_pct"			"50"		// % длительности даже при нулевом заряде
			"chain_damage"			"40 60 80 100 120"
			"chain_interval"			"0.5"
			// Подмена кнопки на «отпустить» — не в тот же кадр, иначе нажатие,
			// которым начали зарядку, тут же её и оборвёт.
			"release_swap_delay"			"0.25"
			"dash_anim_tail"			"0.2"		// запас времени модификатора рывка сверх расчётного
			"speed_fx_charge_pct"			"50"		// с какого % заряда включается шлейф скорости
		}
	}

	//=====================================
	// Chain Hunt — кнопка «отпустить» (подменяет E на время зарядки)
	//=====================================
	"barghest_e_release"
	{
		"BaseClass"					"ability_lua"
		"ScriptFile"				"abilities/barghest/barghest_e_release"
		"AbilityTextureName"		"custom/barghest/barghest_e_release"
		"AbilityBehavior"			"DOTA_ABILITY_BEHAVIOR_NO_TARGET | DOTA_ABILITY_BEHAVIOR_HIDDEN | DOTA_ABILITY_BEHAVIOR_NOT_LEARNABLE | DOTA_ABILITY_BEHAVIOR_IMMEDIATE | DOTA_ABILITY_BEHAVIOR_IGNORE_BACKSWING | DOTA_ABILITY_BEHAVIOR_IGNORE_SILENCE"
		"MaxLevel"					"1"
		"AbilityCooldown"			"0"
		"AbilityManaCost"			"0"
		"AbilityCastPoint"			"0"
	}

	//=====================================
	// Blood of the Beast
	//=====================================
	"barghest_f"
	{
		"BaseClass"					"ability_lua"
		"ScriptFile"				"abilities/barghest/barghest_f"
		"AbilityTextureName"		"custom/barghest/barghest_f"
		"AbilityBehavior"			"DOTA_ABILITY_BEHAVIOR_PASSIVE"
		"AbilityUnitTargetTeam"		"DOTA_UNIT_TARGET_TEAM_ENEMY"
		"AbilityUnitTargetType"		"DOTA_UNIT_TARGET_ALL"
		"AbilityUnitDamageType"		"DAMAGE_TYPE_MAGICAL"
		"LevelsBetweenUpgrades"		"1"
		"MaxLevel"					"1"
		"AbilityCooldown"			"0"
		"AbilityManaCost"			"0"
		"AbilityCastRange"			"0"
		"AbilityCastPoint"			"0"

		"precache"
		{
			"particle"			"particles/hijikata/barghest_passive.vpcf"
			"particle"			"particles/barghest/barghest_lifesteal.vpcf"

			
		}
		"AbilityValues"
		{
			"bonus_mr"			"8"
			"lifesteal_pct"			"12"
			"lifesteal_per_frenzy"			"2"
		}
	}

	//=====================================
	// Beast's Continuation
	//=====================================
	"barghest_r"
	{
		"BaseClass"					"ability_lua"
		"ScriptFile"				"abilities/barghest/barghest_r"
		"AbilityTextureName"		"custom/barghest/barghest_r"
		// OVERSHOOT — курсор задаёт только направление, дальность каста героя не держит.
		// Иконка подменяется в коде (GetAbilityTextureName) по заряженной ветке.
		"AbilityBehavior"			"DOTA_ABILITY_BEHAVIOR_POINT | DOTA_ABILITY_BEHAVIOR_OVERSHOOT | DOTA_ABILITY_BEHAVIOR_IGNORE_BACKSWING"
		"AbilityUnitTargetTeam"		"DOTA_UNIT_TARGET_TEAM_ENEMY"
		"AbilityUnitTargetType"		"DOTA_UNIT_TARGET_ALL"
		"AbilityUnitDamageType"		"DAMAGE_TYPE_MAGICAL"
		"LevelsBetweenUpgrades"		"2"
		"MaxLevel"					"5"
		"AbilityCooldown"			"1"
		"AbilityManaCost"			"75"
		"AbilityCastPoint"			"0.2"
		// перекрывается GetCastAnimation: у каждой ветки своя
		"AbilityCastAnimation"		"ACT_DOTA_CAST_ABILITY_6"
		"precache"
		{
			"particle"			"particles/barghest/barghest_slash_4.vpcf"
			"particle"			"particles/barghest/barghest_slash_vertical_up_thin.vpcf"
			"particle"			"particles/barghest/barghest_slash_vertical.vpcf"
			"particle"			"particles/barghest/barghest_black_dog_proj.vpcf"
			"particle"			"particles/barghest/barghest_black_dog.vpcf"
			
		}
		"AbilityValues"
		{
			"window"			"2"
			"damage"			"120 170 220 270 320"
			"radius"			"300"
			"arc_angle"			"120"
			"uppercut_duration"			"0.6"
			"uppercut_height"			"600"		// на сколько подбрасывает
			"uppercut_push"			"40"		// почти без сдвига: вверх, а не от себя
			"slam_radius"			"350"
			// ⚠️ Каст-пойнт считает GetCastPoint в lua, а не AbilityCastPoint:
			// у волны замах длиннее. AbilityCastPoint в KV = `cast_point`, он же
			// уходит в тултип через %AbilityCastPoint% — держать их равными.
			"cast_point"			"0.2"
			"wave_cast_point"			"0.3"
			"horn_distance"			"800"
			"horn_speed"			"2000"
			"horn_stun"			"1.0"
			"horn_grab_radius"			"200"		// на таком расстоянии таран цепляет врага
			"horn_dash_tail"			"0.1"		// запас времени тарана сверх расчётного
			"horn_impact_delay"			"0.2"		// от остановки до удара рогами
			"horn_impact_anim"			"0.4"		// длина клипа удара после тарана
			"horn_cut_radius"			"300"		// размер эффекта реза на ударе
			"wave_distance"			"1200"
			"wave_width"			"200"			// он же радиус проджектайла волны
			"wave_speed"			"3000"
			"wave_hit_radius"			"200"		// радиус разлёта урона в точке попадания
			"wave_ministun"			"0.3"
			"cd_refund"			"1.0"
			"frenzy_duration"			"6.0"
			"frenzy_as"			"8"
			"frenzy_max"			"5"
		}
	}
}
