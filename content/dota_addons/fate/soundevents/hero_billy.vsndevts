// Billy the Kid — голос на способностях (FGO, VA Takano Urara). Клипы в sounds/billy/vo/.
// Эмиттеры — в abilities/billy/*.lua.
// Trickshot (Q), шанс в коде: 「キャッチして！」 (Catch this!)
"billy_vo_trickshot"
{
    "operator_stacks"
    {
        "update_stack"
        {
            "reference_operator"
            {
                "operator"        "sos_reference_stack"
                "reference_stack"        "dota_src1_3d"
                "operator_variables"
                {
                    "vsnd_files"
                    {
                        "value"
                        {
                            "value0"        "sounds/billy/vo/s105_skill1.vsnd"
                        }
                    }
                    "volume"
                    {
                        "value"        "5.500000"
                    }
                    "pitch"
                    {
                        "value"        "1.000000"
                    }
                }
            }
        }
    }
}
