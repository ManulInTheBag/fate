"DOTAAbilities"
{

	//=====================================
	// Q - Arrow Shot: выстрел стрелой по направлению.
	// Floral даёт Charm, Samsara пробивает насквозь.
	//=====================================
	"kama_arrow_shot"
	{
		"BaseClass"					"ability_lua"
		"ScriptFile"				"abilities/kama/kama_arrow_shot"
		"AbilityBehavior"			"DOTA_ABILITY_BEHAVIOR_POINT"
		"AbilityUnitTargetTeam"		"DOTA_UNIT_TARGET_TEAM_ENEMY"
		"AbilityUnitTargetType"		"DOTA_UNIT_TARGET_HERO | DOTA_UNIT_TARGET_BASIC"
		"AbilityUnitDamageType"		"DAMAGE_TYPE_MAGICAL"
		"LevelsBetweenUpgrades"		"1"
		"MaxLevel"					"5"
		"AbilityCooldown"			"7 6.5 6 5.5 5"
		"AbilityManaCost"			"100"
		// стрела летит по направлению на свою дальность: герой не идёт «в радиус»
		"AbilityCastRange"			"99999"
		"AbilityCastPoint"			"0.2"
		// без этой строки движок сам играет анимацию по номеру слота поверх нашей (жест в OnAbilityPhaseStart)
		"AbilityCastAnimation"		"ACT_INVALID"

		"precache"
		{
			"particle"	"particles/units/heroes/hero_mirana/mirana_spell_arrow.vpcf"
			"particle"	"particles/units/heroes/hero_windrunner/windrunner_spell_powershot.vpcf"
			"soundfile"	"soundevents/game_sounds_heroes/game_sounds_windrunner.vsndevts"
		}
		"AbilityValues"
		{
			"damage"				"120 160 200 240 280"
			"range"					"1400"
			"speed"					"2200"
			"width"					"90"
			"charm"					"10"	// Charm за попадание стрелой Floral
			"cd_reduction"			"1"		// сколько секунд кулдауна Q/W/E снимает попадание
			"cd_reduction_attr"		"2"		// то же с атрибутом 4
			"mana_per_clone"		"50"	// надбавка к цене Q за каждого живого клона W
			"bloom_mana"				"100"	// мана за попадание по цели в области R
		}
	}

	//=====================================
	// W - Embrace of Dreams: клон-объект в точке. Повторяет Q, служит точкой
	// для обмена местами. Работает на зарядах (свои, в стаках модификатора).
	//=====================================
	"kama_embrace_of_dreams"
	{
		"BaseClass"					"ability_lua"
		"ScriptFile"				"abilities/kama/kama_embrace_of_dreams"
		"AbilityBehavior"			"DOTA_ABILITY_BEHAVIOR_POINT | DOTA_ABILITY_BEHAVIOR_IGNORE_BACKSWING"
		"AbilityUnitDamageType"		"DAMAGE_TYPE_MAGICAL"
		"LevelsBetweenUpgrades"		"1"
		"MaxLevel"					"5"
		// кулдауна нет: ограничивают заряды (charge_restore_time)
		"AbilityCooldown"			"0"
		"AbilityManaCost"			"200"
		// клик дальше не ведёт Каму в радиус: клон встаёт на предельной дистанции
		"AbilityCastRange"			"1000"
		"AbilityCastPoint"			"0.1"
		// та же, что движок брал бы по слоту; записана явно
		"AbilityCastAnimation"		"ACT_DOTA_CAST_ABILITY_2"

		"precache"
		{
			"particle"	"particles/zlodemon/zlodemon_basic_circle.vpcf"
		}
		"AbilityValues"
		{
			"max_charges"			"2"
			"charge_restore_time"	"14 13 12 11 10"
			"max_clones"			"2"
			"clone_duration"		"10"
			"clone_spacing"			"120"	// ближе этого к другому клону новый не встаёт
			"clone_leash"			"2500"	// дальше этого от Камы клон исчезает
			"clone_factor"			"50"	// % урона, Charm и снятия кулдауна у выстрела клона
			// обмен местами: приказ атаки в землю не дальше swap_radius от клона
			"swap_radius"			"150"
			"swap_range"			"1500"	// дальше этого от Камы с клоном не поменяться
			"swap_cooldown"			"0"		// пауза между двумя обменами
			// взрыв на прежнем месте Камы, через blast_delay после обмена
			"blast_delay"			"0.3"
			"blast_radius"			"250"
			"blast_damage"			"50"
			"blast_pull_duration"	"0.2"
			"blast_slow"			"40"
			"blast_slow_duration"	"0.75"
		}
	}

	//=====================================
	// E - Petal Volley: поглощает клонов W и стреляет, по стреле за себя и за
	// каждого поглощённого. Floral - очередь по направлению с критом по
	// Charmed, Samsara - лазеры по цели и по одному во врагов рядом.
	//=====================================
	"kama_petal_volley"
	{
		"BaseClass"					"ability_lua"
		"ScriptFile"				"abilities/kama/kama_petal_volley"
		// способ наведения зависит от вида стрел, см. GetBehavior
		"AbilityBehavior"			"DOTA_ABILITY_BEHAVIOR_POINT"
		"AbilityUnitTargetTeam"		"DOTA_UNIT_TARGET_TEAM_ENEMY"
		"AbilityUnitTargetType"		"DOTA_UNIT_TARGET_HERO | DOTA_UNIT_TARGET_BASIC"
		"AbilityUnitDamageType"		"DAMAGE_TYPE_MAGICAL"
		"LevelsBetweenUpgrades"		"2"
		"MaxLevel"					"5"
		"AbilityCooldown"			"50 45 40 35 30"
		"AbilityManaCost"			"400"
		// дальность до цели в Samsara; Floral стреляет по направлению на range
		"AbilityCastRange"			"1200"
		"AbilityCastPoint"			"0.1"
		// без этой строки движок сам играет анимацию по номеру слота поверх нашей (поза в OnAbilityPhaseStart)
		"AbilityCastAnimation"		"ACT_INVALID"

		"precache"
		{
			"particle"	"particles/units/heroes/hero_mirana/mirana_spell_arrow.vpcf"
			"particle"	"particles/units/heroes/hero_drow/drow_base_attack.vpcf"
			"soundfile"	"soundevents/game_sounds_heroes/game_sounds_windrunner.vsndevts"
		}
		"AbilityValues"
		{
			"damage"				"150 190 230 270 310"	// за одну стрелу или лазер
			"charge_time"			"0.5"	// зарядка после каста: Кама стоит и ничего не может
			"arrow_interval"		"0.08"	// пауза между выстрелами очереди; Кама стоит, пока она идёт
			// Floral
			"range"					"1400"
			"speed"					"2200"
			"width"					"90"
			"crit_mult"				"2"		// множитель урона по Charmed-цели
			// Samsara
			"samsara_radius"		"400"	// вокруг цели: каждому врагу здесь по одному лазеру
			"laser_speed"			"3000"
		}
	}

	//=====================================
	// D - Arrow of Desire: усиленная стрела. Floral сразу даёт цели половину
	// шкалы Charm, Samsara тащит до трёх врагов в указанную точку.
	// Кулдаун фиксированный и печатью не сбрасывается (CannotReset в util.lua).
	//=====================================
	"kama_arrow_of_desire"
	{
		"BaseClass"					"ability_lua"
		"ScriptFile"				"abilities/kama/kama_arrow_of_desire"
		"AbilityBehavior"			"DOTA_ABILITY_BEHAVIOR_POINT | DOTA_ABILITY_BEHAVIOR_NOT_LEARNABLE"
		"AbilityUnitTargetTeam"		"DOTA_UNIT_TARGET_TEAM_ENEMY"
		"AbilityUnitTargetType"		"DOTA_UNIT_TARGET_HERO | DOTA_UNIT_TARGET_BASIC"
		"AbilityUnitDamageType"		"DAMAGE_TYPE_MAGICAL"
		"LevelsBetweenUpgrades"		"1"
		"MaxLevel"					"1"
		"AbilityCooldown"			"90"
		"AbilityManaCost"			"400"
		// стрела летит сама: герой не идёт «в радиус», см. GetCastRange
		"AbilityCastRange"			"99999"
		"AbilityCastPoint"			"0.1"
		// без этой строки движок сам играет анимацию по номеру слота поверх нашей (поза в OnAbilityPhaseStart)
		"AbilityCastAnimation"		"ACT_INVALID"

		"precache"
		{
			"particle"	"particles/units/heroes/hero_mirana/mirana_spell_arrow.vpcf"
			"particle"	"particles/units/heroes/hero_windrunner/windrunner_spell_powershot.vpcf"
			"particle"	"particles/zlodemon/zlodemon_basic_circle.vpcf"
			"soundfile"	"soundevents/game_sounds_heroes/game_sounds_windrunner.vsndevts"
		}
		"AbilityValues"
		{
			"charge_time"			"0.5"	// зарядка после каста: Кама стоит и ничего не может
			"range"					"1600"
			// Floral
			"damage"				"300"
			"charm"					"50"
			"speed"					"2400"
			"width"					"110"
			// Samsara
			"max_targets"			"3"
			"drag_speed"			"4000"
			"drag_width"			"150"
			// взрыв в конце пути
			"explosion_radius"		"300"
			"explosion_damage"		"40"
			"explosion_slow"			"25"
			"explosion_slow_duration"	"2"
		}
	}

	//=====================================
	// F - Sugarcane Bow: переключатель стрел Floral / Samsara.
	// Здесь же общие числа Charm: их читают Q, клоны W и D.
	//=====================================
	"kama_sugarcane_bow"
	{
		"BaseClass"					"ability_lua"
		"ScriptFile"				"abilities/kama/kama_sugarcane_bow"
		"AbilityBehavior"			"DOTA_ABILITY_BEHAVIOR_NO_TARGET | DOTA_ABILITY_BEHAVIOR_IMMEDIATE | DOTA_ABILITY_BEHAVIOR_NOT_LEARNABLE | DOTA_ABILITY_BEHAVIOR_IGNORE_PSEUDO_QUEUE | DOTA_ABILITY_BEHAVIOR_IGNORE_CHANNEL"
		"LevelsBetweenUpgrades"		"1"
		"MaxLevel"					"1"
		"AbilityCooldown"			"0.5"
		"AbilityManaCost"			"0"
		"AbilityCastPoint"			"0"
		// смена стрел ничего не анимирует
		"AbilityCastAnimation"		"ACT_INVALID"
		"AbilityValues"
		{
			"charm_max"				"100"	// шкала Charm, на которой цель становится Charmed
			"charm_duration"		"5"		// сколько живёт шкала без новых стаков
			"charmed_duration"		"1.5"
			"charmed_slow"			"80"
			"charm_immunity"		"6"		// сколько после Charmed цель не набирает Charm
		}
	}

	//=====================================
	// R - Blooming Ground: область в точке. Враги в ней замедлены, а любая
	// стрела Камы по цели в области отнимает долю текущего здоровья и
	// добавляет замедление.
	//=====================================
	"kama_blooming_ground"
	{
		"BaseClass"					"ability_lua"
		"ScriptFile"				"abilities/kama/kama_blooming_ground"
		"AbilityBehavior"			"DOTA_ABILITY_BEHAVIOR_POINT | DOTA_ABILITY_BEHAVIOR_AOE"
		"AbilityUnitTargetTeam"		"DOTA_UNIT_TARGET_TEAM_ENEMY"
		"AbilityUnitTargetType"		"DOTA_UNIT_TARGET_HERO | DOTA_UNIT_TARGET_BASIC"
		"AbilityUnitDamageType"		"DAMAGE_TYPE_PURE"
		"LevelsBetweenUpgrades"		"2"
		"MaxLevel"					"5"
		"AbilityCooldown"			"65 60 55 50 45"
		"AbilityManaCost"			"800"
		"AbilityCastRange"			"2000"
		"AbilityCastPoint"			"0.3"
		"AbilityCastAnimation"		"ACT_DOTA_CAST_ABILITY_5"

		"precache"
		{
			"particle"	"particles/zlodemon/zlodemon_basic_circle.vpcf"
		}
		"AbilityValues"
		{
			"radius"				"350"
			"duration"				"5"
			"slow"					"50"
			"arrow_hp_damage"		"5"		// % текущего здоровья за каждую стрелу
			"arrow_slow"			"5"		// добавка к замедлению за каждую стрелу
			"arrow_slow_max"		"100"	// предел этой добавки
		}
	}

	//=====================================
	// Kama Combo
	//=====================================
	"kama_combo"
	{
		"BaseClass"					"ability_lua"
		"ScriptFile"				"abilities/kama/kama_combo"
		"AbilityBehavior"			"DOTA_ABILITY_BEHAVIOR_HIDDEN | DOTA_ABILITY_BEHAVIOR_NO_TARGET | DOTA_ABILITY_BEHAVIOR_IMMEDIATE | DOTA_ABILITY_BEHAVIOR_IGNORE_BACKSWING"
		"AbilityUnitTargetTeam"		"DOTA_UNIT_TARGET_TEAM_ENEMY"
