		"AbilityCooldown"			"130"
		"AbilityManaCost"			"600"
		"AbilityCastRange"			"600"
		"AbilityCastPoint"			"0"
		// заготовка: своей анимации пока нет
		"AbilityCastAnimation"		"ACT_INVALID"
		"AbilityValues"
		{
			"damage"			"800"
			"radius"			"600"
			"stun_duration"			"1.5"
			"delay"			"0.3"
		}
	}

