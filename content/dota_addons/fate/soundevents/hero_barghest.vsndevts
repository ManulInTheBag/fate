// Barghest ability voice lines (FGO, VA Inoue Marina, Servant #310).
// Clips live in sounds/barghest/. Emitted from the ability scripts on cast
// (see abilities/barghest/*.lua). VO самого героя — в
// soundevents/voscripts/game_sounds_vo_dragon_knight.vsndevts (override_hero).
// Knight's Cadence (Q): «Хм!», «Ха!», «Сэй!» — самые короткие выкрики
"barghest_vo_q"
{
	"operator_stacks"
	{
		"update_stack"
		{
			"reference_operator"
			{
				"operator"			"sos_reference_stack"
				"reference_stack"	"dota_src1_3d"
				"operator_variables"
				{
					"vsnd_files"
					{
						"value"
						{
							"value0"	"sounds/barghest/S310_Stage1_Attack4.vsnd"
							"value1"	"sounds/barghest/S310_Stage1_Attack5.vsnd"
							"value2"	"sounds/barghest/S310_Stage2_Attack4.vsnd"
							"value3"	"sounds/barghest/S310_Stage2_Attack5.vsnd"
							"value4"	"sounds/barghest/S310_Stage1_Attack1.vsnd"
							"value5"	"sounds/barghest/S310_Stage2_Attack1.vsnd"
						}
					}
					"volume"	{ "value"	"5.500000" }
					"pitch"		{ "value"	"1.000000" }
				}
			}
		}
	}
}
