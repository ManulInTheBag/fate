# Copy this file to ".env" and fill in your values.

# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=paste-your-bot-token-here

# Channel(s) the bot SILENTLY reads scoreboards from (your group's server).
# It never posts or reacts in these. Enable Developer Mode in Discord
# (Settings -> Advanced), right-click the channel -> Copy Channel ID.
# Comma-separate multiple IDs if you watch more than one channel.
WATCH_CHANNEL_IDS=000000000000000000

# The bot's OWN channel in your private server: it posts each parsed scoreboard
# here for review, sends all stats/exports here, and accepts commands here.
CONTROL_CHANNEL_ID=000000000000000000

# Save scoreboards to stats automatically (true) or only after you react ✅ (false).
AUTO_CONFIRM=false

# Optional: only let these Discord user IDs run commands / confirm. Comma-separated.
# Leave blank to allow everyone in the control channel.
ADMIN_USER_IDS=

# OCR engine: "easyocr" (deep-learning, most accurate, default) or "tesseract".
OCR_ENGINE=easyocr

# Windows path to the Tesseract executable (only used if OCR_ENGINE=tesseract).
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Player-name OCR. Two passes (single-pass can't mix Latin+Cyrillic+CJK):
#   OCR_LANG     = Latin/Cyrillic pass
#   OCR_LANG_CJK = Chinese/Japanese pass (used only when CJK chars are found)
# Leave OCR_LANG_CJK blank to disable CJK reading.
OCR_LANG=eng+rus
OCR_LANG_CJK=chi_sim+chi_tra+jpn
