<!-- Вкладка Effects окна настроек: что показывать в ряду значков над
     хелсбарами (effect_bars.js). Состояние и сохранение на сервер ведёт
     effect_bars.js, эта панель только правит профиль - см. fateanother_effects.js. -->
<root>
	<styles>
		<include src="s2r://panorama/styles/dotastyles.vcss_c" />
		<include src="s2r://panorama/styles/custom_game/fateanother_effects.vcss_c" />
	</styles>
	<scripts>
		<include src="s2r://panorama/scripts/custom_game/fateanother_effects.vjs_c" />
	</scripts>
	<Panel class="EffectsRoot" hittest="false">
		<Panel id="EffectsLeft" class="EffectsColumn" hittest="false">
			<Label class="EffectsHeader" text="#FA_Effects_Title" hittest="false" />
			<ToggleButton id="EffIcons" class="EffectsOption" text="#FA_Config_EffectIcons" onactivate="OnEffIconsToggle()" />
			<ToggleButton id="EffSurvival" class="EffectsOption" text="#FA_Config_SurvivalIcons" onactivate="OnEffSurvivalToggle()" />

			<Label class="EffectsSubHeader" text="#FA_Effects_Scope" hittest="false" />
			<RadioButton id="EffScope_all" group="EffScope" class="EffectsOption" text="#FA_Effects_Scope_all" onactivate="OnEffScope('all')" />
			<RadioButton id="EffScope_from_me" group="EffScope" class="EffectsOption" text="#FA_Effects_Scope_from_me" onactivate="OnEffScope('from_me')" />
			<RadioButton id="EffScope_on_me" group="EffScope" class="EffectsOption" text="#FA_Effects_Scope_on_me" onactivate="OnEffScope('on_me')" />
			<RadioButton id="EffScope_enemies" group="EffScope" class="EffectsOption" text="#FA_Effects_Scope_enemies" onactivate="OnEffScope('enemies')" />
			<RadioButton id="EffScope_allies" group="EffScope" class="EffectsOption" text="#FA_Effects_Scope_allies" onactivate="OnEffScope('allies')" />

			<ToggleButton id="EffOwn" class="EffectsOption EffectsOwn" text="#FA_Effects_Own" onactivate="OnEffOwnToggle()" />
			<Label class="EffectsHint" text="#FA_Effects_Own_Hint" hittest="false" />

			<Panel class="EffectsSaveRow" hittest="false">
				<Button id="EffSave" class="EffectsSaveButton" onactivate="OnEffSave()">
					<Label text="#FA_Effects_Save" />
				</Button>
				<Button id="EffLoad" class="EffectsSaveButton EffectsLoadButton" onactivate="OnEffLoad()">
					<Label text="#FA_Effects_Load" />
				</Button>
				<Label id="EffStatus" class="EffectsStatus" text="" hittest="false" />
			</Panel>
			<Label class="EffectsHint" text="#FA_Effects_Site" hittest="false" />
		</Panel>
		<Panel id="EffectsRight" class="EffectsColumn" hittest="false">
			<Panel class="EffectsListHead" hittest="false">
				<Label class="EffectsHeader" text="#FA_Effects_List" hittest="false" />
				<Button class="EffectsSmallButton" onactivate="OnEffAll(true)">
					<Label text="#FA_Effects_AllOn" />
				</Button>
				<Button class="EffectsSmallButton" onactivate="OnEffAll(false)">
					<Label text="#FA_Effects_AllOff" />
				</Button>
			</Panel>
			<Label class="EffectsHint" text="#FA_Effects_List_Hint" hittest="false" />
			<Panel id="EffList" class="EffectsList" />
		</Panel>

		<!-- Настройки героев: по карточке на Слугу со своими опциями HUD.
		     Применяются, только когда играешь этим Слугой. -->
		<Panel id="EffectsHeroes" class="EffectsColumn" hittest="false">
			<Label class="EffectsHeader" text="#FA_Effects_Heroes" hittest="false" />
			<Label class="EffectsHint EffectsHeroesHint" text="#FA_Effects_Heroes_Hint" hittest="false" />

			<Panel class="EffectsHeroCard" hittest="false">
				<Panel class="EffectsHeroHead" hittest="false">
					<Image class="EffectsHeroPortrait" src="s2r://panorama/images/custom_game/portrait/npc_dota_hero_muerta_png.vtex" scaling="stretch" hittest="false" />
					<Label class="EffectsHeroName" text="#npc_dota_hero_muerta" hittest="false" />
				</Panel>

				<Label class="EffectsSubHeader EffectsHeroSub" text="#FA_Effects_BillyDrum" hittest="false" />
				<RadioButton id="EffBillyDrum_drum" group="EffBillyDrum" class="EffectsOption" text="#FA_Effects_BillyDrum_drum" onactivate="OnEffBillyDrum('drum')" />
				<RadioButton id="EffBillyDrum_number" group="EffBillyDrum" class="EffectsOption" text="#FA_Effects_BillyDrum_number" onactivate="OnEffBillyDrum('number')" />
				<RadioButton id="EffBillyDrum_none" group="EffBillyDrum" class="EffectsOption" text="#FA_Effects_BillyDrum_none" onactivate="OnEffBillyDrum('none')" />
				<ToggleButton id="EffBillyReload" class="EffectsOption EffectsHeroToggle" text="#FA_Effects_BillyReload" onactivate="OnEffBillyReloadToggle()" />

				<ToggleButton id="EffBillyHint" class="EffectsOption EffectsHeroToggle" text="#FA_Effects_BillyHint" onactivate="OnEffBillyHintToggle()" />
			</Panel>
		</Panel>
	</Panel>
</root>
